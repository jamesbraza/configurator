{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  schedule: ["* 2 * * 1"],
  prHourlyLimit: 4,
  timezone: "America/Los_Angeles",
  rangeStrategy: "widen",
  lockFileMaintenance: {
    enabled: true,
  },
  "pre-commit": {
    enabled: true,
  },
  packageRules: [
    {
      // TODO: remove after release of https://github.com/uqfoundation/dill/pull/755,
      // as needed by pylint's parallel mode crashes on Python 3.15: https://github.com/pylint-dev/pylint/issues/11528
      matchPackageNames: ["python"],
      allowedVersions: "<3.15",
    },
    {
      // TODO: remove after https://github.com/jackdewinter/pymarkdown/issues/1751
      matchPackageNames: ["jackdewinter/pymarkdown"],
      allowedVersions: "<0.9.41",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      automerge: true,
    },
    {
      // group:allNonMajor, with automerge
      groupName: "all non-major dependencies",
      groupSlug: "all-minor-patch",
      matchPackageNames: ["*"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
  ],
}
