[include]
	# For the zebra-dark theme below; downloaded per the README's Tool Configurations
	path = ~/.config/git/themes.gitconfig
[core]
	pager = delta
	# Ensure vim is used for amending commits, otherwise default is nano on Debian
	editor = vim
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	# Not built-in to Git, SEE: https://dandavison.github.io/delta/color-moved-support.html
	features = zebra-dark
	# Explicit pager args replace delta's own less defaults (-R, -F), so restate them
	# SEE: https://github.com/dandavison/delta/blob/0.19.2/src/utils/bat/output.rs#L174-L208
	# Add --quiet: disable bell noise when scrolling past the top/bottom of a diff, it's too disturbing at night
	# SEE: https://github.com/dandavison/delta/issues/2234
	pager = less --RAW-CONTROL-CHARS --quit-if-one-screen --quiet
[merge]
	conflictStyle = zdiff3
[alias]
	# SEE: https://coderwall.com/p/euwpig/a-better-git-log
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%Creset' --abbrev-commit
[diff]
	algorithm = histogram
	colorMoved = zebra
[pull]
	rebase = true
[push]
	default = current
[advice]
	skippedCherryPicks = false
